.pio/
.pioenvs/
.piolibdeps/
.vscode/
*.o
*.bin
*.elf

# Simulateur PC : artefacts de build et captures regenerables (voir simulator/README.md)
simulator/build/
simulator/build_check/
simulator/screenshots/
simulator/.simulator_data/
tools/pocketpsn_probe/output/

# Logs generes par scripts/installer_et_lancer.ps1 et scripts/diagnostic_materiel.ps1
# (voir PREMIER_DEMARRAGE.md) -- jamais commiter, y compris en cas de partage de bug.
logs/*.log

# Cle API Pocket PSN partagee, compilee dans le firmware (voir
# include/secrets.example.h et AUDIT.md section 0quater) -- jamais committee.
include/secrets.h

# Binaires de release pour la page d'installation web (voir
# webinstall/README.md) : exception volontaire a "*.bin" ci-dessus --
# ce sont ici des artefacts distribuables, pas des sorties de build a usage
# interne uniquement.
!webinstall/firmware/*.bin
!webinstall_7inch/firmware/*.bin

# LVGL 9.5.0 vendorise pour le simulateur : seul src/ est compile (voir le
# glob de simulator/CMakeLists.txt) et seuls les en-tetes de la racine sont
# inclus. Le reste de la release amont -- tests (70 Mo), demos (30 Mo),
# scripts (19 Mo), docs (13 Mo), exemples (11 Mo) -- n'a aucune raison
# d'entrer dans le depot : cela ferait passer le clone de 26 Mo a 267 Mo.
simulator/third_party/lvgl-9.5.0/*
!simulator/third_party/lvgl-9.5.0/src/
!simulator/third_party/lvgl-9.5.0/lvgl.h
!simulator/third_party/lvgl-9.5.0/lvgl_private.h
!simulator/third_party/lvgl-9.5.0/lv_version.h
!simulator/third_party/lvgl-9.5.0/LICENCE.txt
